# Major Shell — runtime env template.
#
# Copy this file to `shell/.env` and fill in the three secrets.
# `shell/.env` is gitignored. Never commit real values.
#
# Usage:
#   cd ~/Projects/major
#   docker run -d --name shell-A --restart unless-stopped \
#     --env-file shell/.env \
#     major-shell:latest
#
# To use multiple Shells side-by-side, copy this to shell/.env.shell-B
# (etc.) and override SHELL_ID per file.

# ─── Required: identity + API base ───────────────────────────────────

# Unique id for this container. Stored as the row id in the Shell table
# (still `major.runner_instances` until the Phase 3 schema migration renames
# it to `major.shells`). Must be stable across restarts of the same container.
SHELL_ID=shell-A

# Major's API base URL. The dev Supabase project's Functions root, no trailing slash.
MAJOR_API_BASE_URL=https://nuihvxluxdpdjgkvtdih.supabase.co/functions/v1

# ─── Required: secrets ───────────────────────────────────────────────

# Supabase service-role key. Sent as `Authorization: Bearer ...` to Major's API
# alongside `X-Major-Shell-Id`. The auth helper recognizes this as the
# service-role bypass and attributes calls to shell:<SHELL_ID>.
# Retrieve from: Supabase Dashboard → Project Settings → API → service_role
# (or `npx -y supabase projects api-keys --project-ref nuihvxluxdpdjgkvtdih`)
SUPABASE_SERVICE_ROLE_KEY=

# GitHub fine-grained PAT scoped to MioMarker/healthbite + MioMarker/healix.
# Required permissions: Contents (R/W), Pull requests (R/W), Commit statuses
# (R/W), Metadata (R).
# Create at: https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# Claude Code auth — set EITHER of these, not both. The Shell exits if both
# are empty. CLAUDE_CODE_OAUTH_TOKEN (Max subscription) is preferred when
# available; ANTHROPIC_API_KEY is the fallback.
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# ─── Optional ────────────────────────────────────────────────────────

# Image tag, recorded in the Shell row's metadata for provenance.
# IMAGE_TAG=major-shell:2026-05-09
